rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ===== Global Hardened Primitives =====
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDateStr(s) {
      return s is string && s.size() == 10 && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptDateStr(s) {
      return s is string && (s == '' || (s.size() == 10 && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function isValidOptTimeStr(s) {
      return s is string && (s == '' || (s.size() == 5 && s.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    function isValidMonthStr(s) {
      return s is string && (s == '' || (s.size() == 7 && s.matches('^[0-9]{4}-[0-9]{2}$')));
    }

    function isValidHiddenMonths(arr) {
      return arr is list
        && arr.size() <= 60
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() == 7 && arr[0].matches('^[0-9]{4}-[0-9]{2}$')));
    }

    // ===== Entity Validation Blueprints =====
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll(['ownerId', 'monthlyGoal', 'theme', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'monthlyGoal', 'theme', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (data.monthlyGoal is int || data.monthlyGoal is float)
        && data.monthlyGoal >= 0
        && data.monthlyGoal <= 100000000000
        && data.theme in ['system', 'light', 'dark']
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'date', 'time', 'pri', 'done', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'date', 'time', 'pri', 'done', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isValidDateStr(data.date)
        && isValidOptTimeStr(data.time)
        && data.pri in ['high', 'mid', 'low']
        && data.done is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReminder(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'date', 'time', 'done', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'date', 'time', 'done', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isValidDateStr(data.date)
        && isValidOptTimeStr(data.time)
        && data.done is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncomeColumn(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'kind', 'monthScope', 'hiddenMonths', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'kind', 'monthScope', 'hiddenMonths', 'sortOrder', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.kind in ['in', 'out']
        && isValidMonthStr(data.monthScope)
        && isValidHiddenMonths(data.hiddenMonths)
        && (data.sortOrder is int || data.sortOrder is float)
        && data.sortOrder >= 0 && data.sortOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncomeItem(data, userId) {
      return data.keys().hasAll(['ownerId', 'colId', 'date', 'amount', 'client', 'note', 'paid', 'due', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'colId', 'date', 'amount', 'client', 'note', 'paid', 'due', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.colId)
        && isValidDateStr(data.date)
        && (data.amount is int || data.amount is float)
        && data.amount > 0 && data.amount <= 100000000000
        && data.client is string && data.client.size() <= 160
        && data.note is string && data.note.size() <= 400
        && data.paid is bool
        && isValidOptDateStr(data.due)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'body', 'tag', 'pin', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'body', 'tag', 'pin', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.body is string && data.body.size() <= 20000
        && data.tag is string && data.tag.size() <= 60
        && data.pin is bool
        && (data.updatedAtMs is int || data.updatedAtMs is float)
        && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMindmap(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'layout', 'rootNodeId', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'layout', 'rootNodeId', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.layout in ['mind', 'logic', 'org']
        && isValidId(data.rootNodeId)
        && (data.updatedAtMs is int || data.updatedAtMs is float)
        && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMindmapNode(data, userId, mapId) {
      return data.keys().hasAll(['ownerId', 'mapId', 'parentId', 'text', 'collapsed', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'mapId', 'parentId', 'text', 'collapsed', 'sortOrder', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.mapId)
        && data.mapId == mapId
        && data.parentId is string && data.parentId.size() <= 128 && (data.parentId == '' || isValidId(data.parentId))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 200
        && data.collapsed is bool
        && (data.sortOrder is int || data.sortOrder is float)
        && data.sortOrder >= 0 && data.sortOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ===== User Workspace Paths =====
    match /users/{userId}/private/profile {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/settings/preferences {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['monthlyGoal', 'theme', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(taskId)
        && isValidTask(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(taskId)
        && isValidTask(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['done', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'time', 'pri', 'done', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(taskId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow get: if isOwner(userId) && isValidId(reminderId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(reminderId)
        && isValidReminder(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(reminderId)
        && isValidReminder(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['done', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'time', 'done', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(reminderId);
    }

    match /users/{userId}/incomeColumns/{colId} {
      allow get: if isOwner(userId) && isValidId(colId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(colId)
        && isValidIncomeColumn(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(colId)
        && isValidIncomeColumn(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['hiddenMonths', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'monthScope', 'hiddenMonths', 'sortOrder', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(colId);
    }

    match /users/{userId}/incomeItems/{itemId} {
      allow get: if isOwner(userId) && isValidId(itemId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(itemId)
        && isValidIncomeItem(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(userId)/incomeColumns/$(incoming().colId));
      allow update: if isOwner(userId) && isValidId(itemId)
        && isValidIncomeItem(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId)/incomeColumns/$(incoming().colId))
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['paid', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['colId', 'date', 'amount', 'client', 'note', 'paid', 'due', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) && isValidId(noteId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(noteId)
        && isValidNote(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(noteId)
        && isValidNote(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['body', 'tag', 'pin', 'updatedAtMs', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(noteId);
    }

    match /users/{userId}/mindmaps/{mapId} {
      allow get: if isOwner(userId) && isValidId(mapId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(mapId)
        && isValidMindmap(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(mapId)
        && isValidMindmap(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().rootNodeId == existing().rootNodeId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAtMs', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['layout', 'updatedAtMs', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'layout', 'updatedAtMs', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(mapId);

      match /nodes/{nodeId} {
        allow get: if isOwner(userId) && isValidId(mapId) && isValidId(nodeId)
          && exists(/databases/$(database)/documents/users/$(userId)/mindmaps/$(mapId));
        allow list: if isOwner(userId) && isValidId(mapId)
          && existing().ownerId == request.auth.uid
          && existing().mapId == mapId;
        allow create: if isOwner(userId) && isValidId(mapId) && isValidId(nodeId)
          && isValidMindmapNode(incoming(), userId, mapId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId)/mindmaps/$(mapId))
          && (incoming().parentId == '' || existsAfter(/databases/$(database)/documents/users/$(userId)/mindmaps/$(mapId)/nodes/$(incoming().parentId)));
        allow update: if isOwner(userId) && isValidId(mapId) && isValidId(nodeId)
          && isValidMindmapNode(incoming(), userId, mapId)
          && incoming().ownerId == existing().ownerId
          && incoming().mapId == existing().mapId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/mindmaps/$(mapId))
          && (incoming().parentId == '' || exists(/databases/$(database)/documents/users/$(userId)/mindmaps/$(mapId)/nodes/$(incoming().parentId)))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['collapsed', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'collapsed', 'sortOrder', 'parentId', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(mapId) && isValidId(nodeId);
      }
    }
  }
}
